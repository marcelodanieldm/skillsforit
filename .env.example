# SkillsForIT - Environment Variables

# ==============================================
# AUTENTICACIÓN (NextAuth.js + Google OAuth)
# ==============================================
# Secreto para firmar tokens JWT (generar con: openssl rand -base64 32)
NEXTAUTH_SECRET=your-nextauth-secret-change-in-production
NEXTAUTH_URL=http://localhost:3000

# Google OAuth - Obtener en: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ==============================================
# LLM PROVIDERS (Sprint 21)
# ==============================================
# Al menos uno requerido, recomendado los 3 para redundancia

# OpenAI (Primary provider)
# Get your key: https://platform.openai.com/api-keys
# Cost: $0.01 input, $0.03 output per 1K tokens
# Best for: Complex analysis, advanced reasoning
OPENAI_API_KEY=sk-...

# Anthropic Claude (Fallback #1)
# Get your key: https://console.anthropic.com/settings/keys
# Cost: $0.003 input, $0.015 output per 1K tokens
# Best for: Balance between quality and cost
ANTHROPIC_API_KEY=sk-ant-...

# Google Gemini (Fallback #2)
# Get your key: https://makersuite.google.com/app/apikey
# Cost: $0.00025 input, $0.0005 output per 1K tokens (40x cheaper than GPT-4!)
# Best for: Simple tasks, cost optimization
GOOGLE_AI_API_KEY=...

# ==============================================
# LLM FALLBACK CONFIGURATION (Optional)
# ==============================================
# These are the default values - only override if needed

# Primary provider to use first
# Options: 'openai' | 'anthropic' | 'google'
LLM_PRIMARY_PROVIDER=openai

# Fallback order (comma-separated)
# Will try providers in this order after primary fails
LLM_FALLBACK_ORDER=anthropic,google,openai

# Maximum retry attempts per provider
LLM_MAX_RETRIES=2

# Timeout per request in milliseconds (30 seconds default)
LLM_TIMEOUT_MS=30000

# Enable response caching (LRU cache, last 100 entries)
LLM_ENABLE_CACHE=true

# ==============================================
# DATABASE (Supabase)
# ==============================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ==============================================
# AUTHENTICATION
# ==============================================
NEXTAUTH_SECRET=your-nextauth-secret
NEXTAUTH_URL=http://localhost:3000

# ==============================================
# STRIPE (Payments)
# ==============================================
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ==============================================
# EMAIL (SendGrid or similar)
# ==============================================
SENDGRID_API_KEY=SG....
EMAIL_FROM=noreply@skillsforit.com

# ==============================================
# ANALYTICS
# ==============================================
NEXT_PUBLIC_GA_TRACKING_ID=G-...
NEXT_PUBLIC_POSTHOG_KEY=phc_...
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# ==============================================
# FEATURE FLAGS (Optional)
# ==============================================
# Enable/disable specific features
FEATURE_CV_ANALYSIS=true
FEATURE_MENTOR_MATCHING=true
FEATURE_SUBSCRIPTION_PLANS=true
FEATURE_ADMIN_DASHBOARD=true

# ==============================================
# ENVIRONMENT
# ==============================================
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ==============================================
# MONITORING (Optional)
# ==============================================
# External monitoring service
MONITORING_WEBHOOK_URL=https://hooks.slack.com/services/...
UPTIME_ROBOT_API_KEY=...

# ==============================================
# NOTES
# ==============================================
# 
# Sprint 21 Multi-LLM System:
# ---------------------------
# For maximum reliability, configure all 3 LLM providers.
# If only one is configured, there's no fallback.
# 
# Cost Comparison (per 1K tokens):
# - OpenAI:    $0.01 input, $0.03 output
# - Anthropic: $0.003 input, $0.015 output
# - Google:    $0.00025 input, $0.0005 output
# 
# Recommended Strategy:
# - Free users → Google Gemini (lowest cost)
# - Pro users → Anthropic Claude (balance)
# - Enterprise → OpenAI GPT-4 (highest quality)
# 
# Health Monitoring:
# - GET /api/health returns status of all services
# - Status page available at /status
# - Auto-refresh every 30 seconds
# 
# Security:
# - NEVER commit this file with real keys
# - Rotate keys every 90 days
# - Use different keys for dev/staging/prod
# - Keep this file as .env.local (gitignored)
